# AniChin — npm configuration
# Used by Vercel/Netlify/GitHub Actions when running `npm install`

# Resolve peer dependency conflicts gracefully (needed for next-auth@4 + nodemailer@7)
# Some peer deps in the next-auth@4 ecosystem are stricter than necessary.
legacy-peer-deps=true

# Prefer offline installs (faster CI)
prefer-offline=true

# Use exact versions for reproducible builds
save-exact=false

# Audit level — fail CI on high+critical vulnerabilities in production deps
audit-level=high
