# ============================================================================
# AniChin — Caddyfile (Production)
# Auto-HTTPS via Let's Encrypt + security headers + reverse proxy
# Usage:
#   Set SITE_DOMAIN in .env (e.g., anichin.id)
#   docker compose -f docker-compose.prod.yml up -d
#
# Validasi sebelum deploy (wajib — Caddy GAGAL START total kalau ada satu
# direktif/matcher yang salah, dan container `caddy` yang mati berarti situs
# tidak bisa diakses sama sekali):
#   docker compose -f docker-compose.prod.yml run --rm --no-deps caddy \
#     validate --config /etc/caddy/Caddyfile --adapter caddyfile
# ============================================================================

{$SITE_DOMAIN} {
	# ── Security: Remove server fingerprinting ───────────────
	header {
		# Hide Caddy server header
		-Server

		# Security headers (defense-in-depth with Next.js middleware)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=(), sync-xhr=(), document-domain=()"
		X-DNS-Prefetch-Control "off"
		X-Permitted-Cross-Domain-Policies "none"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# Cache static assets aggressively
		/assets/* Cache-Control "public, max-age=31536000, immutable"
		/_next/static/* Cache-Control "public, max-age=31536000, immutable"
	}

	# ── CORS: Restrict to same-origin ────────────────────────
	# API routes don't need cross-origin access from browsers
	@api {
		path /api/*
	}
	handle @api {
		header Access-Control-Allow-Origin "null"
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization"
		header Access-Control-Max-Age "86400"
		reverse_proxy web:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# ── Default: Next.js app ────────────────────────────────
	handle {
		reverse_proxy web:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# ── Compression ──────────────────────────────────────────
	encode gzip zstd

	# ── Logging ──────────────────────────────────────────────
	log {
		output file /data/access.log {
			roll_size 100mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	# ── Rate limiting ────────────────────────────────────────
	# Rate limit ketat ditangani aplikasi lewat Redis (src/lib/rate-limit.ts),
	# bukan di Caddy: limitnya per-akun/per-IP dengan tier berbeda. Jangan
	# menambahkan matcher bernama di sini tanpa direktif yang memakainya —
	# matcher tak dikenal = `caddy validate` gagal = container tidak start.
	#
	# ── Catatan X-Forwarded-For (JANGAN dihapus tanpa alasan) ─
	# Caddy 2.7+ mengabaikan X-Forwarded-* kiriman klien bila sumbernya bukan
	# proxy yang dipercaya (default: tidak ada yang dipercaya), dan blok
	# `header_up X-Forwarded-For {remote_host}` di atas MENIMPA (bukan
	# menambahkan) header itu dengan IP socket asli. Hasilnya rate limit,
	# login lockout, dan audit log aplikasi tidak bisa dipalsukan klien.
	# Kalau situs nanti diletakkan di belakang CDN/LB (Cloudflare dll), aktifkan
	# blok GLOBAL berikut di PALING ATAS file ini dan isi hanya CIDR proxy
	# tersebut — JANGAN pakai `private_ranges` (trafik dari internet masuk ke
	# container lewat gateway Docker yang juga privat, sehingga XFF karangan
	# klien akan ikut dipercaya):
	#
	#   {
	#       servers {
	#           trusted_proxies static 173.245.48.0/20 103.21.244.0/22 ...
	#           client_ip_headers CF-Connecting-IP X-Forwarded-For
	#       }
	#   }
}

# ── WWW → non-WWW redirect ─────────────────────────────────
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# ── Health check endpoint (opsional, untuk load balancer) ───
# Mendengarkan di port 8080 DI DALAM container caddy (tanpa TLS). Supaya bisa
# dipakai health check dari luar, port-nya harus di-publish di
# docker-compose.prod.yml — dan compose saat ini TIDAK mem-publish-nya, jadi
# blok ini praktis tidak terpakai. Health check yang benar-benar dipakai
# deployment adalah /api/health milik aplikasi (dipakai Docker HEALTHCHECK,
# depend_on service_healthy, healthcheck container, dan smoke test pipeline).
:8080 {
	respond /health "ok" 200
}
