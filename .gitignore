# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the template IS committed (README/docs/compose all reference it).
# Without this negation `.env.example` was silently ignored and never existed
# in the repo, so `cp .env.example .env` failed on every fresh clone.
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# NOTE: keep this anchored to the repo root. A bare `test` pattern also matched
# `src/test/` and silently excluded `src/test/setup.ts` from every commit,
# which made the whole Vitest suite unrunnable on a fresh clone.
/test
prompt

server.log
# Skills directory
/skills/

# Production artifacts
/standalone
*.tar.gz

# Database (SQLite dev — production uses PostgreSQL)

# Audit logs (contains hashed IPs — don't commit)
/logs/

# Docker volumes
/pgdata/

# Health check / monitoring temp
.healthcheck.tmp
# Admin credentials (generated locally, never commit)
.env.admin
.env
