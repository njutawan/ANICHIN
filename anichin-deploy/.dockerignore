# ─────────────────────────────────────────────────────────────
# .dockerignore — exclude dev-only artifacts from Docker build context
# Reduces build context size → faster builds + smaller image layer
# ─────────────────────────────────────────────────────────────

# Version control
.git
.gitignore
.gitattributes

# Dependencies (will be reinstalled inside container)
node_modules
**/node_modules

# Build output (regenerated inside container)
.next
out
dist
build

# Environment files — must be injected at runtime via docker-compose env_file
.env
.env.local
.env.production
.env.production.local
.env.development
.env.development.local
.env.test
.env*.example

# Logs (regenerated at runtime)
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SQLite databases (production uses PostgreSQL)
db/*.db
db/*.db-journal
db/*.sqlite
db/*.sqlite-journal

# Docker files themselves (no need to include in image)
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
Dockerfile.*

# IDE / OS / Editor
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Tests & coverage (not needed in production image)
coverage/
.nyc_output/
tests/
**/*.test.ts
**/*.spec.ts
**/*.test.tsx
**/*.spec.tsx

# Dev-only shell scripts (QA / test runners)
scripts/qa-*.sh
scripts/test-*.sh
scripts/test-*.ts

# Tool results / screenshots / dev artifacts at project root
tool-results/
examples/
download/
upload/
screenshot-*.png
r*.png
final-*.png
preview-*.png
qa-*.png
auth-*.png
vlm-*.json

# Project README (already in image via COPY, but skip to slim context)
# README.md  # ← uncomment to exclude; keeping for now since it's small

# Caddyfile is mounted as volume in docker-compose — not needed in image
Caddyfile
