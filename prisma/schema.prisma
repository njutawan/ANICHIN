// Anichin-style anime database schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Anime {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  titleEn         String?
  titleJp         String?
  alternativeTitle String?
  synopsis        String
  poster          String
  banner          String?
  type            String   @default("TV") // TV, Movie, OVA, ONA, Special
  status          String   @default("Ongoing") // Ongoing, Completed, Upcoming
  studio          String?
  source          String?  // Manga, Light Novel, Original, etc.
  releasedYear    Int?
  season          String?  // Winter, Spring, Summer, Fall
  score           Float    @default(0)
  rating          String?  // PG-13, R, etc.
  views           Int      @default(0)
  duration        String?  // "24 min"
  airedDay        String?  // Monday, Tuesday... (for schedule)
  trailer         String?
  featured        Boolean  @default(false)
  trending        Boolean  @default(false)
  popular         Boolean  @default(false)
  rank            Int?
  totalEpisodes    Int?
  releasedEpisodes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  episodes  Episode[]
  genres    AnimeGenre[]
  bookmarks Bookmark[]
  characters AnimeCharacter[]
  staff     AnimeStaff[]
  relationsFrom AnimeRelation[] @relation("fromAnime")
  relationsTo   AnimeRelation[] @relation("toAnime")

  @@index([status])
  @@index([type])
  @@index([airedDay])
  @@index([featured])
  @@index([trending])
  @@index([popular])
  @@index([score])
  @@index([views])
  @@index([releasedYear])
  @@index([createdAt])
  @@index([updatedAt]) // /api/anime sort=latest + sitemap orderBy updatedAt
}

// Self-referencing many-to-many: Sequel/Prequel/SideStory/Alternative
model AnimeRelation {
  id          String @id @default(cuid())
  fromAnimeId String
  toAnimeId   String
  relation    String // "Sequel", "Prequel", "Side Story", "Alternative", "Spin-off", "Parent Story"
  fromAnime   Anime  @relation("fromAnime", fields: [fromAnimeId], references: [id], onDelete: Cascade)
  toAnime     Anime  @relation("toAnime", fields: [toAnimeId], references: [id], onDelete: Cascade)

  @@unique([fromAnimeId, toAnimeId, relation])
  @@index([toAnimeId])
}

model Character {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameJp     String?
  role       String?  // Main, Supporting, Antagonist
  description String?
  image       String?
  createdAt   DateTime @default(now())

  animes AnimeCharacter[]

  @@index([slug])
}

model AnimeCharacter {
  animeId     String
  characterId String
  role        String? // "Main Protagonist", "Supporting", etc.
  anime       Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([animeId, characterId])
  @@index([characterId])
}

model Staff {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameJp     String?
  role        String?  // Director, Studio, Composer, etc.
  image       String?
  createdAt   DateTime @default(now())

  animes AnimeStaff[]

  @@index([slug])
}

model AnimeStaff {
  animeId  String
  staffId  String
  role     String? // "Director", "Composer", "Character Design"
  anime    Anime  @relation(fields: [animeId], references: [id], onDelete: Cascade)
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([animeId, staffId])
  @@index([staffId])
}

model Genre {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  animes AnimeGenre[]
}

model AnimeGenre {
  animeId String
  genreId String
  anime   Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([animeId, genreId])
  @@index([genreId])
}

model Episode {
  id          String   @id @default(cuid())
  animeId     String
  number      Int
  title       String?
  thumbnail   String?
  duration    String?
  releasedAt  DateTime @default(now())
  views       Int      @default(0)
  streamUrl   String?  // HLS (.m3u8) or MP4 stream URL
  download720 String?
  download1080 String?
  download480 String?
  createdAt   DateTime @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([animeId])
  @@index([releasedAt])
  @@index([number])
}

model Bookmark {
  id        String   @id @default(cuid())
  animeId   String
  createdAt DateTime @default(now())
  anime     Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([animeId])
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  password          String
  avatar            String?
  role              String    @default("user") // user, admin
  emailVerified     DateTime? // null = not verified
  twoFactorSecret   String?   // TOTP secret (encrypted) — null = 2FA disabled
  twoFactorEnabled   Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reviews           ServerReview[]
  comments          ServerComment[]
  verificationTokens VerificationToken[]
  passwordResets    PasswordReset[]

  @@index([email])
}

// Email verification tokens (single-use, expire after 24h)
model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Password reset tokens (single-use, expire after 1h)
model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ServerReview {
  id        String   @id @default(cuid())
  animeSlug String
  userId    String
  rating    Int      // 1-10
  comment   String
  likes      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([animeSlug, createdAt]) // daftar ulasan per anime (ORDER BY createdAt DESC)
  @@index([userId])
}

model ServerComment {
  id           String   @id @default(cuid())
  animeSlug    String
  episodeNumber Int
  userId       String
  comment      String
  likes        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([animeSlug, episodeNumber, createdAt]) // komentar per episode (ORDER BY createdAt DESC)
  @@index([userId])
}
