{
  "name": "anichin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "prebuild": "bash scripts/setup-env.sh || true",
    "build": "node scripts/build.js",
    "vercel-build": "prisma generate && next build",
    "postinstall": "prisma generate || echo 'Prisma generate skipped (likely no schema.prisma yet)'",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "seed": "bun run scripts/seed.ts",
    "db:migrate:prod": "prisma generate && prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --name init",
    "db:migrate:status": "prisma migrate status",
    "setup-env": "bash scripts/setup-env.sh",
    "analyze": "ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "healthcheck": "curl -s http://localhost:3000/api/health | bun -e 'process.stdin.on(\"data\",d=>{try{const j=JSON.parse(d);console.log(j.status=== \"ok\"?\"✓ Healthy\":\"✗ Unhealthy\",j)}catch{}})'"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.75.2",
    "@tanstack/react-query": "^5.103.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "ioredis": "^6.0.0",
    "lucide-react": "0.525.0",
    "next": "^16.3.5",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "otplib": "^13.5.0",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "3.10.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "^1.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "dotenv": "^17.2.3"
  },
  "trustedDependencies": [
    "@embedded-postgres/linux-x64"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
