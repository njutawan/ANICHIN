# ============================================================================
# AniChin — Environment Variables (template)
# ============================================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored on purpose — never commit real secrets.
# Values marked [WAJIB] make the app/CLI fail if missing (or fall back to an
# insecure dev-only value when NODE_ENV !== production).
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL — the Prisma schema is provider="postgresql")
# ----------------------------------------------------------------------------
# [WAJIB] Local dev (docker run / embedded postgres on port 5433):
DATABASE_URL="postgresql://anichin:anichin@localhost:5432/anichin?schema=public"
# Docker Compose production (host `db`). JANGAN dipakai: `web` memakai role
# aplikasi DML-only (F-16) — lihat docker-compose.prod.yml. Nilai berikut hanya
# untuk service `migrate` yang memang butuh DDL:
# DATABASE_URL="postgresql://anichin:${POSTGRES_PASSWORD}@db:5432/anichin?schema=public"
# DATABASE_URL="postgresql://anichin_app:${POSTGRES_APP_PASSWORD}@db:5432/anichin?schema=public"

# Password for the PostgreSQL container in docker-compose.prod.yml / staging.
# Ini kredensial role MIGRASI/owner (punya hak DDL) — dipakai `migrate`
# (prisma migrate deploy) dan `backup-cron` (pg_dump) saja.
# Generate with: openssl rand -hex 32
# Leave empty in the template: production compose/startup rejects empty values.
POSTGRES_PASSWORD=""

# [WAJIB untuk prod/staging] Password role APLIKASI (`anichin_app`), hak DML
# saja — dipakai service `web` supaya bug di aplikasi tidak bisa DROP/ALTER
# tabel. Berbeda dari POSTGRES_PASSWORD di atas; compose menolak start tanpa
# salah satu. Generate with: openssl rand -hex 32
POSTGRES_APP_PASSWORD=""

# ----------------------------------------------------------------------------
# Auth / NextAuth
# ----------------------------------------------------------------------------
# [WAJIB] Canonical URL of the deployment, no trailing slash.
NEXTAUTH_URL="http://localhost:3000"
# [WAJIB] JWT/session signing secret, min 32 chars. Generate:
#   openssl rand -hex 32
NEXTAUTH_SECRET=""

# OAuth providers (optional — login page hides buttons when unset).
# Google:  https://console.cloud.google.com/apis/credentials
# GitHub:  https://github.com/settings/developers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Set to 1 to print OAuth misconfiguration warnings in the server log.
NEXT_PUBLIC_DEBUG_OAUTH=""

# ----------------------------------------------------------------------------
# 2FA (TOTP) — secret encryption key
# ----------------------------------------------------------------------------
# [WAJIB di production] 64 hex chars (32 bytes) for AES-256-GCM.
# Generate with: openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=""

# ----------------------------------------------------------------------------
# Email / SMTP (verification + password reset mails)
# ----------------------------------------------------------------------------
# SMTP is optional in development (verification URLs are logged there), but
# SMTP_HOST, SMTP_USER, and SMTP_PASS are required for production startup so
# email ownership verification can actually be delivered.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for port 465 (implicit TLS)
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AniChin <no-reply@anichin.id>"

# ----------------------------------------------------------------------------
# Redis (opsional) — rate limiting, lockout login, DAN pending secret 2FA
# ----------------------------------------------------------------------------
# Tanpa REDIS_URL semuanya jatuh ke penyimpanan in-memory: benar untuk satu
# instance, tetapi rate limit/lockout jadi per-proses dan handshake 2FA
# (`/setup` di instance A, `/enable` di instance B) bisa gagal. Isi di produksi
# yang berjalan lebih dari satu replika (compose sudah menyetel ini).
# REDIS_URL="redis://localhost:6379"

# ----------------------------------------------------------------------------
# URL publik situs (canonical, sitemap, OG, JSON-LD)
# ----------------------------------------------------------------------------
# [WAJIB untuk deploy non-produksi] Tanpa ini, semua canonical/OG/sitemap
# memakai default https://anichin.id. Prefix NEXT_PUBLIC_ wajib agar nilainya
# tersedia di browser (dipakai client component untuk link share).
NEXT_PUBLIC_SITE_URL=""

# ----------------------------------------------------------------------------
# Host gambar eksternal (image optimizer)
# ----------------------------------------------------------------------------
# `next/image` hanya mau mengoptimasi gambar dari host di daftar ini. Default
# (lihat src/lib/image-hosts.ts) sudah mencakup CDN umum: s4.anilist.co,
# cdn.myanimelist.net, image.tmdb.org.
#
# Tambahkan CDN sendiri di sini — daftar dipisah koma/spasi, boleh URL utuh
# atau wildcard subdomain. Sama seperti Next: `*.bunnycdn.com` hanya mencakup
# subdomain, jadi tulis apex-nya juga bila perlu.
# Nilai ini dibaca saat BUILD (masuk ke images.remotePatterns) dan oleh
# komponen di browser, jadi rebuild setelah mengubahnya.
#   NEXT_PUBLIC_IMAGE_HOSTS="cdn.saya.id, bunnycdn.com, *.bunnycdn.com"
#
# Gambar dari host yang tidak terdaftar tetap tampil (langsung dari sumbernya,
# tanpa optimizer) — tidak error, hanya tidak dikonversi ke WebP/AVIF.
# NEXT_PUBLIC_IMAGE_HOSTS=""

# ----------------------------------------------------------------------------
# Proxy / rate limiting
# ----------------------------------------------------------------------------
# Jumlah reverse proxy tepercaya di depan aplikasi. X-Forwarded-For hanya
# dipercaya dari arah kanan sebanyak nilai ini (anti-spoofing).
#   1 = Vercel / Netlify / Cloudflare saja (default)
#   2 = CDN + load balancer (mis. Cloudflare -> Nginx -> app)
# TRUSTED_PROXY_HOPS="1"

# Salt rahasia untuk hash IP di audit log (HMAC-SHA256).
# Generate: openssl rand -hex 32
# Tanpa ini, dipakai salt acak per-proses (hash berubah setiap restart).
IP_HASH_SALT=""

# ----------------------------------------------------------------------------
# Pencabutan sesi (JWT)
# ----------------------------------------------------------------------------
# JWT bersifat stateless, jadi `sessionVersion` di DB divalidasi ulang secara
# berkala: begitu password direset atau role diubah admin, semua token lama
# (termasuk milik penyerang yang mencuri cookie) berhenti berlaku paling lama
# sebesar nilai ini — bukan menunggu JWT kedaluwarsa (7 hari).
#
#   0    = validasi setiap request (paling ketat, 1 query DB per request ber-sesi)
#   60   = default: pencabutan berlaku ≤60 detik, ~1 query DB/menit/sesi
#   3600 = paling longgar (maksimum yang diterima aplikasi)
# SESSION_REVALIDATE_SECONDS="60"

# ----------------------------------------------------------------------------
# Monitoring (optional)
# ----------------------------------------------------------------------------
# SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_RELEASE=""
# NEXT_PUBLIC_SENTRY_RELEASE=""
# SENTRY_DEBUG="false"
# LOG_LEVEL="info"           # debug | info | warn | error
# MAX_MEMORY_MB="512"        # heap guard used by the memory watchdog

# ----------------------------------------------------------------------------
# Build / deploy knobs
# ----------------------------------------------------------------------------
# NODE_ENV="production"
# PORT="3000"
# HOSTNAME="0.0.0.0"
# NEXT_TELEMETRY_DISABLED="1"
# DEPLOY_TARGET="standalone" # set by docker-compose (Docker) — do not set on Vercel
# ANALYZE="true"             # enables @next/bundle-analyzer on `npm run build`

# Nilai NEXT_PUBLIC_* di-inline ke bundle browser saat BUILD (tidak bisa
# ditimpa saat runtime). Kosongkan bila domain publik = NEXTAUTH_URL.
# NEXT_PUBLIC_SITE_URL="https://anichin.id"
# Versi cache service worker. Kosong = otomatis dari commit SHA build.
# Pipeline Deploy Production mengisi ini dengan SHA commit.
# NEXT_PUBLIC_BUILD_ID="abc1234"

# Domain for the Caddy reverse proxy (docker-compose.prod.yml, optional).
SITE_DOMAIN="anichin.id"

# Nama image yang dipakai docker-compose.prod.yml. Biarkan terisi hanya bila
# server menarik image hasil CI dari registry (mis. GHCR); kalau kosong, compose
# memakai default `anichin/anichin:prod-current` + `:prod-migrate` — sama dengan
# tag yang di-push pipeline Deploy Production. Pipeline mengisi dua baris ini
# otomatis saat REGISTRY diset.
# ANICHIN_IMAGE="ghcr.io/your-org/anichin:prod-current"
# ANICHIN_MIGRATE_IMAGE="ghcr.io/your-org/anichin:prod-migrate"
